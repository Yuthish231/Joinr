# Copy to .env for running without Docker. Every setting has a safe default for local use.
DEBUG=true
SECRET_KEY=change-me
# DATABASE_URL=postgres://joinr:password@localhost:5432/joinr    (default: local SQLite file)
# SESSION_IDLE_SECONDS=1800
# SESSION_ABSOLUTE_SECONDS=28800
# MAX_CONCURRENT_SESSIONS=3
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# LEAVER_CUTOFF_HOUR=18
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=joinr,dc=local
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=joinr,dc=local
